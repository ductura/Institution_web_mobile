{
  "name": "@ductura/web-mobile",
  "version": "0.2.0",
  "private": true,
  "description": "Ductura mobilni frontend za mobitele i tablete",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 5174",
    "start": "next start -p 5174",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:helpers && pnpm test:functional",
    "test:helpers": "node --test \"tests/*.test.js\"",
    "test:functional": "playwright test",
    "fake-server": "node tests/e2e/lazni-server.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3"
  }
}
