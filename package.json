{
  "name": "@ductura/web-mobile",
  "version": "0.2.0",
  "private": true,
  "description": "Ductura mobilni frontend za mobitele i tablete",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:packages": "node src/lib/build-work-packages.mjs && node app/prijavi-problem/build-polja.mjs",
    "dev": "pnpm build:packages && next dev -p 5174",
    "start": "next start -p 5174",
    "build": "pnpm build:packages && next build",
    "lint": "eslint .",
    "typecheck": "pnpm build:packages && tsc --noEmit",
    "test": "pnpm test:helpers && pnpm test:functional",
    "test:helpers": "pnpm build:packages && node --test \"tests/!(prijava-problema).test.js\" && vitest run --config app/prijavi-problem/vitest.config.mjs tests/prijava-problema.test.js",
    "test:functional": "playwright test",
    "fake-server": "node tests/e2e/lazni-server.mjs"
  },
  "dependencies": {
    "@ductura/contracts": "https://github.com/ductura/Institution_server/releases/download/contracts-v2.9.1/ductura-contracts-2.9.1.tgz",
    "@ductura/editor-core": "github:ductura/Institution_front_web_chrome#29f90e53328f4f416e5bd7c8569a7a315b9f51e0&path:packages/editor-core",
    "@ductura/ui": "github:ductura/Institution_front_web_chrome#29f90e53328f4f416e5bd7c8569a7a315b9f51e0&path:packages/ui",
    "@noble/curves": "2.4.0",
    "@tiptap/core": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "26.1.0",
    "rolldown": "1.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
