{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",
    "lib": ["dom", "dom.iterable", "es2023"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["app", "src", "tests", "next.config.mjs", "playwright.config.mjs"],
  "exclude": ["node_modules", ".next"]
}
