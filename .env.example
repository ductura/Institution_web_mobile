# Copy to .env.local and adjust. No secrets belong in this file or in the repo.

# Address of Institution_server (server side only, read at runtime).
INSTITUTION_SERVER_URL=http://127.0.0.1:4000

# Base path of the app, read at build time (e.g. /app/mobile behind the edge
# proxy). Empty means the pages are served at "/".
BASE_PATH=

# Port of the fake Institution_server used by the functional tests
# (tests/e2e/lazni-server.mjs); the Playwright config sets it itself.
# LAZNI_PORT=4099

# Disables Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1
